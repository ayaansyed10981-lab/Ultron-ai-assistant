{
  "name": "jarvis-assistant",
  "version": "1.0.0",
  "description": "Personal 24/7 Voice AI Assistant (Jarvis) built natively for Windows 11 ARM64 (Snapdragon) powered by Gemini API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:silent": "node src/index.js --no-cli",
    "train:voice": "node src/enroll_voice.js",
    "train:all": "node src/enroll_voice.js --agent all",
    "train:ultron": "node src/enroll_voice.js --agent ultron",
    "train:vision": "node src/enroll_voice.js --agent vision",
    "train:friday": "node src/enroll_voice.js --agent friday",
    "train:jarvis": "node src/enroll_voice.js --agent jarvis",
    "train:veronica": "node src/enroll_voice.js --agent veronica",
    "diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-arm64-diagnostics.ps1",
    "install-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "uninstall-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "docx": "^9.15.4",
    "dotenv": "^16.4.7",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "sherpa-onnx-node": "^2.0.1"
  }
}
