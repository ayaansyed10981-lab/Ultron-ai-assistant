# ============================================================
# JARVIS AI ASSISTANT - Windows 11 ARM64 (Snapdragon) Config
# ============================================================

# Required: Get your free or paid Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Core Gemini Models (Current Generation)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Speech Output Configuration
# Options: windows (instant ~80ms native ARM64 voice, unlimited 24/7) | gemini (expressive Gemini 3.8 TTS, 10/day free tier)
TTS_ENGINE=windows
# Prebuilt Gemini voices: Charon, Fenrir, Orus, Puck, Kore, Aoede, Zephyr
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_STYLE=calm, articulate, subtly witty British AI butler
# Windows WinRT voice substring (Mark, David, Zira)
WINDOWS_TTS_VOICE=Mark

# Wake Word Configuration (100% local offline ARM64 sherpa-onnx neural KWS)
WAKE_WORDS=Jarvis,Hey Jarvis,Okay Jarvis,OK Jarvis
# Minimum confidence
WAKE_CONFIDENCE=Medium

# Voice Activity Detection (Snappy low-latency command capture)
RECORD_WAIT_SPEECH_MS=4000
RECORD_SILENCE_MS=800
RECORD_MAX_MS=9000
# Base RMS threshold (automatically adapts to your room's ambient noise floor)
VAD_THRESHOLD=260

# Conversation & Behavior
# Listen briefly for a follow-up question after Jarvis finishes speaking (0 to disable)
FOLLOW_UP_SECONDS=3
# Conversation history resets after this many minutes of inactivity
SESSION_RESET_MINUTES=20
# Allow Jarvis to execute safe PowerShell commands on your computer (true | false)
ALLOW_SHELL=true
# Show Windows System Tray icon (true | false)
ENABLE_TRAY=true
# Play subtle audio chimes when Jarvis wakes up (true | false)
ENABLE_CHIMES=true
# Speak greeting when Jarvis starts (true | false)
GREET_ON_START=true
